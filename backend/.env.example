# ============================================================
# KeyLocator Backend - Variables d'environnement
# Copiez ce fichier en .env et adaptez les valeurs
# ============================================================

# Base de données MySQL (XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=keylocator
DB_USER=root
DB_PASSWORD=

# Sécurité JWT
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Mode LED (V1 : simulated | V2 : mqtt)
LED_MODE=simulated
LED_DUREE_SECONDES=15

# YOLO (mock | real)
YOLO_MODE=mock
YOLO_MODEL_PATH=ml/best.pt
YOLO_CONFIDENCE_THRESHOLD=0.6
BLUR_THRESHOLD=40.0

# Serveur
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# [V2] MQTT (non utilisé en V1 - décommentez pour la V2)
# MQTT_BROKER=localhost
# MQTT_PORT=1883
# MQTT_USER=
# MQTT_PASSWORD=
